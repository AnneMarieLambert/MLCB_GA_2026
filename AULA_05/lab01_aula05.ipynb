import pandas as pd
import numpy as np
from gensim.models import FastText

# --- Passo 1: Configuração do Dataset ---
# COMENTE a linha abaixo colocando uma hashtag (#) na frente se não tiver o arquivo:
# df = pd.read_csv("sac_moveis_ac2.csv")

# Deixe esta parte ativa para que o script crie dados de teste automaticamente:
dados_exemplo = {
    "mensagem": [
        "MEU sofá!!! chegou quebrado e quero DEVOLVER!!!",
        "Gostaria de saber se vocês estão DEVOLVENDO os valores das mesas compradas!!!",
        "A cadeira veio sem os parafusos da montagem.",
        "Atrasou a entrega do meu guarda-roupa, quero cancelar.",
        "A mesa veio riscada na lateral esquerda."
    ],
    "categoria": ["devolucao", "estorno", "suporte", "cancelamento", "suporte"]
}
df = pd.DataFrame(dados_exemplo)

print("Dataset simulado carregado com sucesso.")

# --- Passo 2: Aplicar a esteira de pré-processamento do Exercício 1 ---

df["mensagem_limpa"] = df["mensagem"].apply(limpar_e_lemmatizar)

# --- Passo 3: Transformar em lista de tokens e construir o corpus ---
corpus_tokenizado = [frase.split() for frase in df["mensagem_limpa"] if frase]

# --- Passo 4: Treinar o modelo FastText ---
print("Treinando o modelo FastText...")
modelo_fasttext = FastText(
    sentences=corpus_tokenizado,
    vector_size=50,
    window=3,
    min_count=1,
    workers=4,
    sg=1
)
print("Modelo FastText treinado com sucesso!\n")


# --- Passo 5: Construção da função de Mean Pooling ---
def obter_vetor_frase(frase, modelo):
    """
    Transforma uma frase em um vetor denso utilizando
    FastText + Mean Pooling.
    """
    palavras = frase.split()
    vetores = []

    for palavra in palavras:
        try:
            
            vetor = modelo.wv[palavra]
            
            vetores.append(vetor)
        except KeyError:
            continue

    if len(vetores) == 0:
        return np.zeros(modelo.vector_size)

    vetor_medio = np.mean(vetores, axis=0)
    
    return vetor_medio


# --- Passo 6: Demonstração e Validação do Exercício ---
print("=== TESTE DE MEAN POOLING ===")

frase_exemplo = df["mensagem_limpa"].iloc[0]
vetor_resultado = obter_vetor_frase(frase_exemplo, modelo_fasttext)

print(f"Frase original: '{df['mensagem'].iloc[0]}'")
print(f"Frase limpa:    '{frase_exemplo}'")
print(f"Formato do vetor gerado (Shape): {vetor_resultado.shape}")
print(f"Primeiros 5 valores do vetor:    {vetor_resultado[:5]}...")


X = np.array([obter_vetor_frase(frase, modelo_fasttext) for frase in df["mensagem_limpa"]])
print(f"\nMatriz final pronta para Classificação (X): Formato {X.shape}")

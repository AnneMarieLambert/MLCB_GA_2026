)


# EXERCICIO 2 #

import pandas as pd
import numpy as np
from gensim.models import FastText

# --- Passo 1: Configuração do Dataset ---

dados_exemplo = {
    "mensagem": [
        "MEU sofá!!! chegou quebrado e quero DEVOLVER!!!",
        "Gostaria de saber se vocês estão DEVOLVENDO os valores das mesas compradas!!!",
        "A cadeira veio sem os parafusos da montagem.",
        "Atrasou a entrega do meu guarda-roupa, quero cancelar.",
        "A mesa veio riscada na lateral esquerda."
    ],
    "categoria": ["devolucao", "estorno", "suporte", "cancelamento", "suporte"]
}
df = pd.DataFrame(dados_exemplo)

print("Dataset simulado carregado com sucesso.")

# --- Passo 2: Aplicar a esteira de pré-processamento do Exercício 1 ---

df["mensagem_limpa"] = df["mensagem"].apply(limpar_e_lemmatizar)

# --- Passo 3: Transformar em lista de tokens e construir o corpus ---
corpus_tokenizado = [frase.split() for frase in df["mensagem_limpa"] if frase]

# --- Passo 4: Treinar o modelo FastText ---
print("Treinando o modelo FastText...")
modelo_fasttext = FastText(
    sentences=corpus_tokenizado,
    vector_size=50,
    window=3,
    min_count=1,
    workers=4,
    sg=1
)
print("Modelo FastText treinado com sucesso!\n")


# --- Passo 5: Construção da função de Mean Pooling ---
def obter_vetor_frase(frase, modelo):
    """
    Transforma uma frase em um vetor denso utilizando
    FastText + Mean Pooling.
    """
    palavras = frase.split()
    vetores = []

    for palavra in palavras:
        try:

            vetor = modelo.wv[palavra]

            vetores.append(vetor)
        except KeyError:
            continue

    if len(vetores) == 0:
        return np.zeros(modelo.vector_size)

    vetor_medio = np.mean(vetores, axis=0)

    return vetor_medio


# --- Passo 6: Demonstração e Validação do Exercício ---
print("=== TESTE DE MEAN POOLING ===")

frase_exemplo = df["mensagem_limpa"].iloc[0]
vetor_resultado = obter_vetor_frase(frase_exemplo, modelo_fasttext)

print(f"Frase original: '{df['mensagem'].iloc[0]}'")
print(f"Frase limpa:    '{frase_exemplo}'")
print(f"Formato do vetor gerado (Shape): {vetor_resultado.shape}")
print(f"Primeiros 5 valores do vetor:    {vetor_resultado[:5]}...")


X = np.array([obter_vetor_frase(frase, modelo_fasttext) for frase in df["mensagem_limpa"]])
print(f"\nMatriz final pronta para Classificação (X): Formato {X.shape}")


# EXERCICIO 3 #

import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import classification_report

# --- 1. Carregar os Dados Reais do Arquivo ---
try:
    df = pd.read_csv("/content/sac_moveis_ac2_treino.csv")
except FileNotFoundError:
    df = pd.read_csv("sac_moveis_ac2_treino.csv")

print(f"Dataset real carregado com sucesso! Total de linhas: {len(df)}")

print("Aplicando a esteira de pré-processamento nas mensagens...")
df["mensagem_limpa"] = df["mensagem"].apply(limpar_e_lemmatizar)

# --- 2. Gerar Vetores Reais via Mean Pooling (Exercício 2) ---
print("Transformando as mensagens do arquivo em vetores semânticos...")
X_vetores = np.array([obter_vetor_frase(frase, modelo_fasttext) for frase in df["mensagem_limpa"]])

coluna_alvo = "categoria" if "categoria" in df.columns else "intencao"
y = df[coluna_alvo].values 
print(f"Utilizando a coluna '{coluna_alvo}' como alvo da classificação.")

# --- 3. Separar os dados ---
X_train, X_test, y_train, y_test = train_test_split(
    X_vetores,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

# --- 4. Treinar o modelo ---
modelo_classificador = LogisticRegression(max_iter=1000)
modelo_classificador.fit(X_train, y_train)
print("Modelo de Regressão Logística treinado com dados reais!\n")

# --- 5. Avaliar o modelo ---
y_pred = modelo_classificador.predict(X_test)
print("=== RELATÓRIO DE CLASSIFICAÇÃO REAL ===")
print(classification_report(y_test, y_pred, zero_division=0))

# --- 6. Criar o Fallback Corrigido ---
def classificar_mensagem(mensagem, modelo, modelo_embedding, limiar=0.50):
    """
    Classifica uma mensagem do SAC baseando-se no vetor semântico.
    Se a maior probabilidade for menor que o limiar, aciona o Fallback Humano.
    """
    vetor = obter_vetor_frase(mensagem, modelo_embedding)
    vetor_redimensionado = vetor.reshape(1, -1)
    
    # 2. Obter as probabilidades (retorna uma matriz 2D, ex: [[0.1, 0.7, 0.2]])
    probabilidades = modelo.predict_proba(vetor_redimensionado)[0] 
    
    # 3. Identificar a intenção com maior probabilidade
    indice_maior_prob = np.argmax(probabilidades)
    maior_confianca = probabilidades[indice_maior_prob]
    intencao_predita = modelo.classes_[indice_maior_prob]
    
    # 4. Verificar se a confiança cumpre o critério do limiar
    if maior_confianca >= limiar:
        return f"RESPOSTA AUTOMÁTICA ({intencao_predita}) - Confiança: {maior_confianca:.2%}"
    else:
        return f"FALLBACK_HUMANO - Confiança máxima de {maior_confianca:.2%} é menor que o limiar."

# --- 7. Testar o chatbot ---
testes = [
    "quero devolver meu sofá",
    "como faço para realizar a devolução?",
    "cadê meu pedido?",
    "meu pedido nao chego",
    "qual é a previsão do tempo?"
]

print("\n=== TESTANDO O CHATBOT COM INTENÇÕES E FALLBACK ===")
for frase in testes:
    frase_normalizada = limpar_e_lemmatizar(frase)
    resultado_chatbot = classificar_mensagem(
        mensagem=frase_normalizada, 
        modelo=modelo_classificador, 
        modelo_embedding=modelo_fasttext, 
        limiar=0.50
    )
    print(f"Entrada: '{frase}'")
    print(f"Ação:   {resultado_chatbot}\n")


import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression

# 1. Dataset de Exemplo (Agência de Viagens - Mínimo 12 frases e 3 intenções)
dados_viagem = {
    'mensagem': [
        'Quero comprar uma passagem para Paris',
        'Como faço para reservar um voo para Natal?',
        'Preciso de passagem aérea barata para o Rio',
        'Gostaria de emitir um bilhete de avião',
        
        'Quero cancelar a minha reserva de hotel',
        'Preciso desistir do meu voo e pedir reembolso',
        'Como faço para cancelar minha viagem?',
        'Quero estornar a compra do pacote de viagens',
        
        'Quero falar com um atendente humano',
        'Preciso de suporte especializado agora',
        'Suporte, me transfira para um atendente por favor',
        'Como falo com uma pessoa do atendimento?'
    ],
    'intencao': [
        'comprar_passagem', 'comprar_passagem', 'comprar_passagem', 'comprar_passagem',
        'cancelar_reserva', 'cancelar_reserva', 'cancelar_reserva', 'cancelar_reserva',
        'falar_atendente', 'falar_atendente', 'falar_atendente', 'falar_atendente'
    ]
}

df_viagem = pd.DataFrame(dados_viagem)

# 2. Separação de Atributos (X) e Rótulos (y)
X = df_viagem['mensagem']
y = df_viagem['intencao']

# 3. Divisão em Treino e Teste 
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.25, random_state=42)

# 4. Vetorização do Texto (Escolha: TF-IDF)
vectorizer = TfidfVectorizer()
X_train_vec = vectorizer.fit_transform(X_train)
X_test_vec = vectorizer.transform(X_test)

# 5. Algoritmo de Classificação 
modelo_nlu = LogisticRegression()
modelo_nlu.fit(X_train_vec, y_train)

# 6. Teste com Frases INÉDITAS
frases_ineditas = [
    "Preciso reservar um voo para São Paulo com urgência",
    "Não vou mais viajar e quero o cancelamento",
    "Alguém pode me ajudar? Quero falar com suporte humano"
]

# Transformação e Predição das frases inéditas
frases_ineditas_vec = vectorizer.transform(frases_ineditas)
predicoes_finais = modelo_nlu.predict(frases_ineditas_vec)

# 7. Exibição dos Resultados no Console
print("--- RESULTADOS DO DESAFIO NLU (AGÊNCIA DE VIAGENS) ---")
for frase, intencao in zip(frases_ineditas, predicoes_finais):
    print(f"Mensagem do Usuário: '{frase}' \n==> Intenção Identificada: [{intencao}]\n")
